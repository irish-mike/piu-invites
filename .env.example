# Copy to .env.local and set the ID from your Formspark form's submission URL.
# Server-only: do not use a NEXT_PUBLIC_ prefix. Submission itself needs no token.
FORMSPARK_FORM_ID=

# Optional public interest milestone: upgraded workspace, submissions:read scope.
FORMSPARK_API_TOKEN=

# Optional fake submissions for npm run dev only; never sends registrations.
REGISTRATION_PREVIEW=false
